# Variables de entorno para StockControl
# Copiar este archivo a .env y modificar los valores

# Aplicación
APP_NAME=StockControl
VERSION=1.0.0
DEBUG=True

# Seguridad - CAMBIAR EN PRODUCCIÓN
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion-123456789

# Base de datos
DATABASE_URL=sqlite:///./stockcontrol.db

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Configuración de negocio
DEFAULT_MIN_STOCK=10
EXPIRATION_ALERT_DAYS=7
ALLOW_ZERO_STOCK_SALES=False
